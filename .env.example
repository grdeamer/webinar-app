# Minimal local environment variables for webinar-app
# Copy this file to .env.local and fill in the values.
# Never commit .env.local — it is already gitignored.

# ---------------------------------------------------------------------------
# Required for the app to boot
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------

ADMIN_TOKEN_SECRET=
# Fallbacks used by set-admin script if ADMIN_TOKEN_SECRET is not set
ADMIN_PASSWORD=
ADMIN_KEY=

JWT_SECRET=
PRESENTER_ACCESS_SECRET=
BROADCAST_CREDENTIALS_KEY=
EXTERNAL_PUBLISHING_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------

RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=

# ---------------------------------------------------------------------------
# Live streaming (LiveKit)
# ---------------------------------------------------------------------------

LIVE_PROVIDER=livekit
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WEBHOOK_SECRET=

# Optional: recording egress to S3
LIVEKIT_EGRESS_S3_BUCKET=
LIVEKIT_EGRESS_S3_REGION=
LIVEKIT_EGRESS_S3_ACCESS_KEY=
LIVEKIT_EGRESS_S3_SECRET=
LIVEKIT_EGRESS_S3_ENDPOINT=

# ---------------------------------------------------------------------------
# Public app URL
# ---------------------------------------------------------------------------

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------------------

JOTFORM_WEBHOOK_SECRET=
