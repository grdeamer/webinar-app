[Unit]
Description=Jupiter self-hosted media relay (no recorder or Egress)
After=network-online.target caddy.service
Wants=network-online.target
[Service]
User=jupiter-producer
Group=jupiter-producer
ExecStartPre=+/opt/jupiter-producer/selfhost/prepare-relay.py
ExecStart=/opt/jupiter-producer/bin/livekit-server-1.13.11 --config /run/jupiter-livekit/livekit.json
RuntimeDirectory=jupiter-livekit
RuntimeDirectoryMode=0700
RuntimeMaxSec=25min
TimeoutStopSec=15
KillMode=control-group
Restart=no
LimitCORE=0
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/run/jupiter-livekit
StandardOutput=null
StandardError=null
