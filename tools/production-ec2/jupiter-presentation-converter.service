[Unit]
Description=Jupiter bounded PowerPoint conversion broker
[Service]
ExecStart=/usr/bin/python3 /usr/local/lib/jupiter-presentation-converter.py
RuntimeDirectory=jupiter-converter
RuntimeDirectoryMode=0700
LimitCORE=0
MemoryMax=256M
TasksMax=16
TimeoutStopSec=5
KillMode=control-group
StandardOutput=null
StandardError=null
