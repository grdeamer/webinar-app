abi <abi/4.0>,
include <tunables/global>

# Exact executable from playwright-core 1.62.1, owned/writable only by root.
# Chromium's namespace/seccomp sandbox remains enabled; no global sysctl change.
profile jupiter-producer-chromium /opt/jupiter-producer/browsers/chromium_headless_shell-1234/chrome-headless-shell-linux64/chrome-headless-shell flags=(unconfined) {
  userns,
}
