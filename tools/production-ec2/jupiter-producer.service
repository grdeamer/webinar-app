[Unit]
Description=Jupiter producer engine (live memory buffers only)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/jupiter-producer/ready
[Service]
Type=simple
User=jupiter-producer
Group=jupiter-producer
WorkingDirectory=/opt/jupiter-producer
EnvironmentFile=/etc/jupiter-producer/engine.env
Environment=TMPDIR=/run/jupiter-producer
Environment=HOME=/run/jupiter-producer
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/jupiter-producer/browsers
Environment=PRODUCER_ENGINE_NETWORK_START_FILE=/run/jupiter-producer/network-start.json
Environment=PRODUCER_ENGINE_SESSION_CAP_USD=5
ExecStart=/opt/jupiter-producer/start-engine.sh
Restart=no
RuntimeDirectory=jupiter-producer
RuntimeDirectoryMode=0700
RuntimeMaxSec=25min
TimeoutStopSec=25
KillMode=control-group
LimitCORE=0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/run/jupiter-producer
[Install]
WantedBy=multi-user.target
