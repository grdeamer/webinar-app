FROM docker.io/library/ubuntu:22.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
 ca-certificates xvfb xauth x11-utils pulseaudio dbus-x11 \
 libatomic1 libglib2.0-0 libcairo2 libx11-6 libxcb1 libxcb-xfixes0 libxcb-shape0 \
 libxcb-shm0 libxcb-randr0 libxcb-image0 libxcb-keysyms1 libxcb-xtest0 libxcb-cursor0 \
 libxcb-icccm4 libxcb-render-util0 libxcb-xkb1 libxkbcommon-x11-0 libgbm1 libdrm2 \
 libxfixes3 libgl1 libegl1 libopengl0 libasound2 libnss3 libnspr4 libxcomposite1 \
 libxdamage1 libxrandr2 libxtst6 libxi6 libxrender1 libfontconfig1 libfreetype6 \
 libpulse0 libdbus-1-3 libxkbcommon0 libwayland-client0 libwayland-server0 \
 libsm6 libice6 libxss1 libsqlite3-0 libzstd1 libvulkan1 fonts-dejavu-core \
 && rm -rf /var/lib/apt/lists/*
RUN useradd --uid 1000 --create-home --shell /bin/sh satellite \
 && mkdir -p /opt/jupiter /var/.zoomsdk /var/opt/zoomsdk \
 && chown -R satellite:satellite /var/.zoomsdk /var/opt/zoomsdk
COPY entrypoint.sh /opt/jupiter/entrypoint.sh
RUN chmod 0555 /opt/jupiter/entrypoint.sh
USER 1000:1000
WORKDIR /home/satellite
ENTRYPOINT ["/opt/jupiter/entrypoint.sh"]
CMD ["--preflight"]
