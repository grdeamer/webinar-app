[Unit]
Description=Jupiter satellite worker heartbeat guard
After=local-fs.target

[Service]
Type=simple
User=ubuntu
ExecStart=/usr/bin/python3 /home/ubuntu/jupiter-zoom/worker_health.py
Restart=always
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/jupiter-zoom/rooms
LimitCORE=0

[Install]
WantedBy=multi-user.target
