[Unit]
Description=Stop idle Jupiter Io EC2 capacity
After=jupiter-zoom-controller.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/ubuntu/jupiter-zoom/idle_stop.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/run/jupiter-io
LimitCORE=0

[Install]
WantedBy=multi-user.target
