[Unit]
Description=Jupiter Zoom Bridge controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/jupiter-zoom
RuntimeDirectory=jupiter-zoom-pulse
Environment=XDG_RUNTIME_DIR=/run/jupiter-zoom-pulse
Environment=PULSE_SERVER=unix:/run/jupiter-zoom-pulse/pulse/native
ExecStartPre=/usr/bin/pulseaudio --start --exit-idle-time=-1
ExecStart=/usr/bin/python3 /home/ubuntu/jupiter-zoom/controller.py
Restart=on-failure
RestartSec=5
UMask=0077
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
