[Unit]
Description=Jupiter Zoom Bridge controller
After=network-online.target jupiter-io-audio.service jupiter-io-display.service
Wants=network-online.target jupiter-io-display.service jupiter-io-worker-health.service
Requires=jupiter-io-audio.service

[Service]
Type=simple
User=ubuntu
RuntimeDirectory=jupiter-io
RuntimeDirectoryMode=0700
WorkingDirectory=/home/ubuntu/jupiter-zoom
Environment=XDG_RUNTIME_DIR=/run/jupiter-io-audio
Environment=PULSE_SERVER=unix:/run/jupiter-io-audio/pulse/native
ExecStart=/usr/bin/python3 /home/ubuntu/jupiter-zoom/controller.py
Restart=on-failure
RestartSec=5
UMask=0077
TimeoutStopSec=30
LimitCORE=0

[Install]
WantedBy=multi-user.target
